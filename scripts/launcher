#!/usr/bin/env bun
import {$} from 'bun'

const cmd = process.argv[2]

const sway = {
    workspaces: async () => (await $`swaymsg -t get_workspaces`.json()).map(ws => ws.name),
    gotoWs:     async name => $`swaymsg workspace ${name}`,
    moveToWs:   async name => $`swaymsg move container to workspace ${name}`,
    renameWs:   async name => $`swaymsg rename workspace to ${name}`,
}

// Hyprland 0.55+ with a Lua config routes every IPC dispatch through the Lua
// evaluator, so legacy string dispatchers ("workspace name:foo") are syntax
// errors. Everything below is emitted as a Lua expression instead.
const luaStr = s => '"' + s
    .replace(/\\/g, '\\\\')
    .replace(/"/g, '\\"')
    .replace(/\n/g, '\\n') + '"'

async function resolveHyprlandTarget(name) {
    const list = await $`hyprctl workspaces -j`.json()
    const existing = list.find(w => !w.special && (w.name === name || String(w.id) === name))
    if (existing) {
        if (existing.id && existing.id > 0) {
            return String(existing.id)
        }
        return luaStr('name:' + existing.name)
    }
    return /^\d+$/.test(name) ? name : luaStr('name:' + name)
}

const hyprland = {
    workspaces: async () => {
        const list = await $`hyprctl workspaces -j`.json()
        const filtered = list.filter(ws => !ws.special && !ws.name.startsWith('special:'))
        filtered.sort((a, b) => {
            const aId = (a.id && a.id > 0) ? a.id : Infinity
            const bId = (b.id && b.id > 0) ? b.id : Infinity
            if (aId !== bId) return aId - bId
            return a.name.localeCompare(b.name)
        })
        return Array.from(new Set(filtered.map(ws => ws.name)))
    },
    gotoWs:     async name => $`hyprctl dispatch ${`hl.dsp.focus({workspace=${await resolveHyprlandTarget(name)}})`}`,
    moveToWs:   async name => $`hyprctl dispatch ${`hl.dsp.window.move({workspace=${await resolveHyprlandTarget(name)}})`}`,
    renameWs:   async name => {
        const ws = await $`hyprctl activeworkspace -j`.json()
        const target = (ws.id && ws.id > 0) ? ws.id : luaStr('name:' + ws.name)
        return $`hyprctl dispatch ${`hl.dsp.workspace.rename({workspace=${target}, name=${luaStr(name)}})`}`
    },
}

async function pickWorkspace(wm, prompt) {
    const workspaces = await wm.workspaces()
    return (await $`echo ${workspaces.join('\n')} | fuzzel --dmenu --prompt=${prompt} --lines=${workspaces.length}`.text()).trim()
}

async function launcher(wm, cmd) {
    switch (cmd) {
        case 'menu':
            await $`fuzzel`
            break
        case 'go-to-ws': {
            const chosen = await pickWorkspace(wm, 'Go to Workspace: ')
            if (chosen) await wm.gotoWs(chosen)
            break
        }
        case 'move-to-ws': {
            const chosen = await pickWorkspace(wm, 'Move to Workspace: ')
            if (chosen) await wm.moveToWs(chosen)
            break
        }
        case 'rename-ws': {
            const chosen = (await $`fuzzel --dmenu --lines=0 --prompt='Rename to: '`.text()).trim()
            if (chosen) await wm.renameWs(chosen)
            break
        }
        default:
            console.error(`Usage: ${process.argv[1]} {menu|go-to-ws|move-to-ws|rename-ws}`)
            process.exit(1)
    }
}

const wm = Bun.env.HYPRLAND_INSTANCE_SIGNATURE ? hyprland
         : Bun.env.SWAYSOCK                    ? sway
         : null

if (!wm) {
    console.error('Error: neither Sway nor Hyprland detected')
    process.exit(1)
}

await launcher(wm, cmd)
