#!/usr/bin/env bun
import {$} from 'bun'
import {readdirSync, statSync, copyFileSync} from 'fs'
import {dirname, basename} from 'path'

const branch = process.argv[2]

if (!branch) {
    console.error('Usage: gewt <existing-branch-name>')
    process.exit(1)
}

try {
    await $`git rev-parse --is-inside-work-tree`.quiet()
} catch {
    console.error('Error: must be inside a git repository')
    process.exit(1)
}

const repoRoot = (await $`git rev-parse --show-toplevel`.text()).trim()
const wtDir = `${dirname(repoRoot)}/${basename(branch)}`

console.log(`Creating worktree at ${wtDir} for existing branch '${branch}'...`)
try {
    await $`git worktree add ${wtDir} ${branch}`
} catch {
    console.error(`Error: failed to create worktree. Ensure branch '${branch}' exists.`)
    process.exit(1)
}

console.log(`Copying untracked root files to ${wtDir}...`)
for (const file of readdirSync('.')) {
    if (file === '.git') continue
    if (!statSync(file).isFile()) continue
    if ((await $`git ls-files --error-unmatch ${file}`.nothrow().quiet()).exitCode === 0) continue
    copyFileSync(file, `${wtDir}/${file}`)
    console.log(`  -> Copied ${file}`)
}

console.log(`Worktree ready: ${wtDir}`)
