#!/bin/bash
# Ensure a branch name was provided
if [[ -z "$1" ]]; then
    echo "Usage: gewt <existing-branch-name>"
    exit 1
fi

# Check if we are actually in a git repository
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: You must be inside a git repository to run this."
    exit 1
fi

branch_name="$1"
repo_root="$(git rev-parse --show-toplevel)"
wt_dir="$(dirname "$repo_root")/$branch_name"

# 1. Create the worktree for the existing branch
# Notice the absence of the -b flag here.
echo "Creating worktree at $wt_dir for existing branch '$branch_name'..."
if ! git worktree add "$wt_dir" "$branch_name"; then
    echo "Error: Failed to create worktree. Ensure the branch '$branch_name' actually exists."
    exit 1
fi

# 2. Copy untracked/ignored files from the root
echo "Copying untracked root files to $wt_dir..."

# Loop through all visible and hidden items in the current directory
for file in * .*; do
    # Skip standard directory pointers and the .git folder itself
    if [[ "$file" == "." || "$file" == ".." || "$file" == ".git" ]]; then
        continue
    fi

    # Only proceed if it is a regular file (no directories)
    if [[ -f "$file" ]]; then
        # git ls-files --error-unmatch fails if the file is NOT tracked.
        # If it fails, we know the file is untracked or ignored by .gitignore
        if ! git ls-files --error-unmatch "$file" >/dev/null 2>&1; then
            cp "$file" "$wt_dir/"
            echo "  -> Copied $file"
        fi
    fi
done

echo "Worktree ready: $wt_dir"
