#!/usr/bin/env -S node --experimental-default-type=module

import { spawn } from 'node:child_process'
import path from 'node:path'
import { tmpdir } from 'node:os'

const timestamp = Date.now()
const TMP_MONITORS = path.join(tmpdir(), `nwg-monitors-${timestamp}.conf`)
const TMP_WORKSPACES = path.join(tmpdir(), `nwg-workspaces-${timestamp}.conf`)

console.log('Starting nwg-displays (One-Shot Mode)...')
console.log('Arrange monitors -> Apply -> Script copies aligned config & exits.\n')

const nwg = spawn('nwg-displays', ['-m', TMP_MONITORS, '-w', TMP_WORKSPACES], {
  env: { ...process.env, PYTHONUNBUFFERED: '1' }
})

let isSaving = false
let captureBuffer = []
let debounceTimer = null

nwg.stdout.on('data', (chunk) => {
  const lines = chunk.toString().split('\n')

  for (const line of lines) {
    if (line.includes('[Saving]')) {
      console.log('Detected "Apply". Processing...')
      isSaving = true
      captureBuffer = []
      continue
    }

    if (isSaving && line.trim().startsWith('monitor=')) {
      captureBuffer.push(line.trim())
      
      clearTimeout(debounceTimer)
      debounceTimer = setTimeout(() => {
        nwg.kill('SIGKILL')

        const profile = formatKanshi(captureBuffer)
        console.log(profile)
        
        copyAndExit(profile)
      }, 100)
    }
  }
})

function formatKanshi (lines) {
  const monitors = new Map()

  // 1. Parse and Aggregate
  for (const line of lines) {
    const raw = line.replace('monitor=', '')
    const parts = raw.split(',')
    const name = parts[0]

    if (!monitors.has(name)) {
      monitors.set(name, { 
        id: name, 
        status: 'enable', // Default to enable
        mode: null, 
        pos: null, 
        scale: null, 
        transform: 'normal' 
      })
    }
    const config = monitors.get(name)

    // Check for "disable" flag
    if (parts[1] === 'disable' || parts[1] === 'disabled') {
      config.status = 'disable'
      config.mode = null // Clear mode if disabled
    } 
    // Check for "transform" line
    else if (parts[1] === 'transform') {
      config.transform = mapTransform(parts[2])
    } 
    // Standard config line
    else {
      config.mode = parts[1]
      config.pos = parts[2]
      config.scale = parts[3]
    }
  }

  // 2. Format & Align
  const rows = []
  
  for (const m of monitors.values()) {
    // Skip if enabled but missing mode (incomplete config line)
    if (m.status === 'enable' && !m.mode) continue

    let id = m.id
    if (id.startsWith('desc:')) id = `"${id.slice(5)}"`

    if (m.status === 'disable') {
      rows.push({
        id: `output ${id}`,
        status: 'disable',
        mode: '',
        pos: '',
        scale: '',
        transform: ''
      })
    } else {
      let mode = m.mode
      if (!mode.includes('Hz')) mode += 'Hz'
      
      const pos = m.pos.replace('x', ',')

      rows.push({
        id: `output ${id}`,
        status: 'enable',
        mode: `mode ${mode}`,
        pos: `position ${pos}`,
        scale: `scale ${m.scale}`,
        transform: `transform ${m.transform}`
      })
    }
  }

  // Calculate padding widths
  const wId = Math.max(...rows.map(r => r.id.length))
  const wStatus = Math.max(...rows.map(r => r.status.length))
  const wMode = Math.max(...rows.map(r => r.mode.length))
  const wPos = Math.max(...rows.map(r => r.pos.length))
  const wScale = Math.max(...rows.map(r => r.scale.length))

  // Build Strings
  const alignedOutputs = rows.map(r => {
    // Base: ID + Status
    let line = `\t${r.id.padEnd(wId)}  ${r.status.padEnd(wStatus)}`
    
    // Append details only if enabled
    if (r.status === 'enable') {
      line += `  ${r.mode.padEnd(wMode)}  ${r.pos.padEnd(wPos)}  ${r.scale.padEnd(wScale)}  ${r.transform}`
    }
    return line.trimEnd() // Remove trailing spaces for disabled lines
  })

  return `profile {\n${alignedOutputs.join('\n')}\n}`
}

function mapTransform (code) {
  const map = {
    '0': 'normal',
    '1': '90',
    '2': '180',
    '3': '270',
    '4': 'flipped',
    '5': 'flipped-90',
    '6': 'flipped-180',
    '7': 'flipped-270'
  }
  return map[code] || 'normal'
}

function copyAndExit (text) {
  const copier = spawn('wl-copy', [], {
    detached: true, 
    stdio: ['pipe', 'ignore', 'ignore'] 
  })

  copier.on('error', (err) => {
    console.error('⚠️  wl-copy failed:', err.message)
    process.exit(1)
  })

  copier.stdin.write(text)
  copier.stdin.end()
  copier.unref() 

  console.log('✅ Copied to clipboard!')
  process.exit(0)
}
