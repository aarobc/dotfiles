{
    "height": 30,
    "layer": "top",
    "margin": "0 0",

    "group/left": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/workspaces",
            "hyprland/submap",
            "sway/workspaces",
            "sway/mode"
            // TODO: mpris disabled 2026-08-26 — waybar 0.15.0 mpris module
            // segfaults when a player vanishes/stops (Gtk::Widget::set_visible
            // on a freed widget), which kills the whole bar process.
            // Upstream: https://github.com/Alexays/Waybar/issues/2747
            // Re-enable here and in the "mpris" block below once fixed.
            // , "mpris"
        ]
    },

    "group/group-volume": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": true,
            "reveal-delay": 400
        },
        "modules": ["pulseaudio", "pulseaudio/slider"]
    },

    "group/right": {
        "orientation": "horizontal",
        "modules": [
            "clock",
            "custom/shot",
            "idle_inhibitor",
            "group/group-volume",
            "cpu",
            "temperature",
            "battery",
            "tray"
        ]
    },

    "modules-left":   ["group/left"],
    "modules-center": [],
    "modules-right":  ["group/right"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-scroll-up":   "~/dotfiles/waybar/scroll.sh 0",
        "on-scroll-down": "~/dotfiles/waybar/scroll.sh 1"
    },
    "hyprland/submap": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "hyprland/window": {
        "separate-outputs": true,
        "max-length": 40
    },

    "sway/workspaces": {
        "disable-scroll-wraparound": true,
        "disable-scroll":            false,
        "enable-bar-scroll":         true,
        "all-outputs":               false
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    // "mpris": {
    //     "format": "{status_icon} {artist} - {title}",
    //     "format-paused": "{status_icon} {artist} - {title}",
    //     "status-icons": {
    //         "playing": "",
    //         "paused":  "",
    //         "stopped": ""
    //     },
    //     "max-length": 40,
    //     "on-click": "playerctl play-pause"
    // },


    "custom/shot": {
        "format":   " shot ",
        "on-click": "grim -g \"$(slurp)\" - | swappy -f -"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated":   "",
            "deactivated": ""
        }
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format":         "{:%I:%M}",
        "format-alt":     "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        "critical-threshold": 80,
        "warning-threshold":  60,
        "format":             "",
        "tooltip-format":     "{temperatureC}°C"
    },
    "backlight": {
        "format":       "{percent}% {icon}",
        "format-icons": ["", ""]
    },
    "battery": {
        "states": {
            "good":     95,
            "warning":  30,
            "critical": 15
        },
        "format":          "{icon}",
        "format-charging": "",
        "format-plugged":  "",
        "format-alt":      "{capacity}% {icon}",
        "tooltip-format":  "{capacity}% — {time}",
        "format-icons":    ["", "", "", "", ""]
    },
    "network": {
        "format-wifi":         "{essid} ({signalStrength}%) ",
        "format-ethernet":     "{ipaddr} ",
        "format-linked":       "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt":          "{ifname}: {ipaddr}"
    },
    "pulseaudio": {
        "scroll-step":            1,
        "format":                 "{icon}",
        "format-bluetooth":       "{icon}",
        "format-bluetooth-muted": "",
        "format-muted":           "",
        "tooltip-format":         "{volume}%",
        "format-icons": {
            "headphone":  "",
            "hands-free": "",
            "headset":    "",
            "default":    ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "mpd": {
        "format":              "{stateIcon} {artist} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S})",
        "format-disconnected": "Disconnected ",
        "format-stopped":      "Stopped ",
        "interval":            2,
        "state-icons": {
            "paused":  "",
            "playing": ""
        },
        "tooltip-format":              "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    }
}
