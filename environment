_JAVA_AWT_WM_NONREPARENTING=1

PATH=$HOME/.local/bin:$PATH
PATH=$PATH:$HOME/.npm-global/bin
PATH=$PATH:$HOME/.local/share/JetBrains/Toolbox/bin
PATH=$PATH:$HOME/.cargo/bin

NODE_PATH=$HOME/.npm-global/lib/node_modules
