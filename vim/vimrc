" Backup configuration: plain vim, no plugins, no package manager.
" Neovim is the daily driver (see ../nvim); this exists so a machine without it,
" or a broken nvim config, still gets the muscle memory.
"
" Everything editor-agnostic lives in shared/, which nvim/init.lua sources too --
" edit there, not here, so both editors stay in step. What is left below is
" either vim-only, or a plugin-free stand-in for something nvim does with a plugin.
"
" Vim finds this file at $XDG_CONFIG_HOME/vim/vimrc (~/.config/vim/vimrc) only
" when neither ~/.vimrc nor ~/.vim/vimrc exists -- see :help xdg-vimrc.

set nocompatible

let s:shared = expand('<sfile>:p:h') . '/shared'
for s:file in ['options.vim', 'mappings.vim', 'autocmds.vim', 'commands.vim']
  execute 'source' fnameescape(s:shared . '/' . s:file)
endfor

" After the source loop, not before: both of these run filetype detection over
" the buffer for the file named on the command line, and any FileType autocmd
" registered later would miss it. See the note in shared/options.vim.
filetype plugin indent on
syntax on

"------------------------------------------------------------------[Vim only]----
" nvim ships unokai; vim's closest bundled dark scheme is habamax.
silent! colorscheme habamax

" nvim defaults these on; vim does not.
set hidden
set ttyfast
set display=truncate
set nrformats-=octal
set sessionoptions-=options
set viewoptions-=options
set shortmess+=F
set formatoptions+=j
set history=10000
set tabpagemax=50
set wildoptions=pum,tagfile
set belloff=all

" keep the swap/undo/viminfo litter out of ~ and out of this repo
set directory=~/.cache/vim/swap//
set undodir=~/.cache/vim/undo//
set viminfofile=~/.cache/vim/viminfo
set undofile
silent! call mkdir(expand('~/.cache/vim/swap'), 'p')
silent! call mkdir(expand('~/.cache/vim/undo'), 'p')

"-------------------------------------------------[Plugin-free stand-ins]----
" Same keys as the nvim config, backed by whatever vim has built in.

"nvim: NERDTree -> netrw
nnoremap <silent> <C-f> :Explore<CR>

"nvim: telescope git_files / buffers -> :find and the buffer list
set path+=**
set wildignore+=*/.git/*,*/node_modules/*,*/vendor/*
nnoremap <C-p> :find<Space>
nnoremap <C-b> :buffers<CR>:buffer<Space>

"nvim: lua/gitgrep.lua -> :grep into the quickfix list, ripgrep if it is around.
"<leader>g honours .gitignore, <leader>f does not -- same split as gitgrep.lua.
if executable('rg')
  set grepprg=rg\ --vimgrep\ --smart-case
  set grepformat=%f:%l:%c:%m
  nnoremap <leader>g :silent grep!<Space>
  nnoremap <leader>f :silent grep! --no-ignore --hidden --glob=!.git<Space>
else
  nnoremap <leader>g :silent grep! -rn<Space>
  nnoremap <leader>f :silent grep! -rn<Space>
endif
augroup vimrc
  au QuickFixCmdPost grep,grepadd cwindow
augroup END

"nvim: lua/filerefs.lua -> grep for the current file's stem. Crude next to asking a
"language server, but the stem is what an import writes: './target', use App\Target.
"Hits inside the file itself are the price of not having an import graph here.
nnoremap <silent> <leader>u :execute 'silent grep! ' . shellescape(expand('%:t:r'))<CR>

"nvim: lua/tabmerge.lua -- no builtin equivalent, so this key is left unmapped
"nvim: lua/windowswap.lua (<leader>yw/pw/ww) -- likewise

"enable the builtin matchit plugin (nvim loads it by default)
silent! packadd! matchit
