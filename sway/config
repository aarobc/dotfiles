# Mod1 = alt, Mod4 = Windows key
set $mod    Mod4
set $sup    Mod1

set $apos   24
set $comma  25
set $period 26
set $p      27

set $r 32
set $l 33

set $o 39
set $e 40
set $u 41
set $i 42

set $d 43
set $h 44
set $t 45
set $n 46
set $s 47

set $j 54
set $k 55
set $m 58
set $y 89

# standard stuff
font                    pango:SFNS Text Medium 14px
#border only, no titlebar
default_border          pixel 1
default_floating_border pixel 1

gaps          inner 20
smart_gaps    on
smart_borders on
mouse_warping output

# hide_edge_borders       both

# class                 border  backgr  text    indicator child
client.focused          #4c7899 #285577 #ffffff #2e9ef4   #65FF32
client.focused_inactive #333333 #5f676a #ffffff #484e50   #5f676a
client.unfocused        #333333 #222222 #888888 #292d2e   #22222200
client.urgent           #2f343a #900000 #ffffff #900000   #900000

client.background       #ffffff

popup_during_fullscreen smart

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

mode  "Passthrough Mode - Press Alt+F12 to exit" {
  bindsym $mod+F12         mode "default"
  bindsym $mod+$sup+Escape mode "default"
}

set $laptop eDP-1
# bindswitch lid:on output $laptop disable
# bindswitch lid:on systemctl suspend
bindswitch lid:off output $laptop enable

bindcode Ctrl+51 exec 1password --fill
bindsym $mod+F12         mode "Passthrough Mode - Press Alt+F12 to exit"
bindsym $mod+$sup+Escape mode "Passthrough Mode - Press Alt+F12 to exit"

# start a terminal
bindsym $mod+Return exec --no-startup-id foot

# kill focused window
bindcode $mod+Shift+$apos kill

# start dmenu (a program launcher)
# bindcode $mod+$e exec --no-startup-id dmenu_run
bindcode $mod+$e exec --no-startup-id ~/dotfiles/scripts/launcher menu

# move desktop monitor
bindcode $mod+Shift+Control+$h move workspace to output left
bindcode $mod+Shift+Control+$s move workspace to output right

bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output

# change focus
bindcode $mod+$h focus left
bindcode $mod+$t focus down
bindcode $mod+$n focus up
bindcode $mod+$s focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# move focused window
bindcode $mod+Shift+$h move left
bindcode $mod+Shift+$t move down
bindcode $mod+Shift+$n move up
bindcode $mod+Shift+$s move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindcode $mod+$d split h

# split in vertical orientation
bindcode $mod+$k split v

# enter fullscreen mode for the focused container
bindcode $mod+$u fullscreen

# change container layout (stacked, tabbed, toggle split)
# bindcode $mod+$o      layout stacking
# bindcode $mod+$comma  layout tabbed
bindcode $mod+$period layout default

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# switch to workspace
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10
#
# # move focused container to workspace
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

# reload the configuration file
bindcode $mod+Shift+$j reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindcode $mod+Shift+$r exec swaymsg reload
# exit i3 (logs you out of your X session)
# bindcode $mod+Shift+$period exec "swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -b 'Yes, exit i3' 'i3-msg exit'"
bindcode $mod+Shift+$period exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -b 'Yes, exit sway' 'swaymsg exit'

# Prompt with existing workspaces to switch to
bindcode $mod+$m exec ~/dotfiles/scripts/launcher go-to-ws

# Prompt with existing workspaces to move the current window to
bindcode $mod+Shift+$m exec ~/dotfiles/scripts/launcher move-to-ws
bindcode $mod+$p exec ~/dotfiles/scripts/launcher rename-ws

# resize window (you can also use the mouse for that)
mode "resize" {
  # These bindings trigger as soon as you enter the resize mode

  # Pressing left will shrink the window’s width.
  # Pressing right will grow the window’s width.
  # Pressing up will shrink the window’s height.
  # Pressing down will grow the window’s height.
  bindcode $h resize shrink width 10 px or 10 ppt
  bindcode $t resize grow height 10 px or 10 ppt
  bindcode $n resize shrink height 10 px or 10 ppt
  bindcode $s resize grow width 10 px or 10 ppt

  # same bindings, but for the arrow keys
  bindsym Left resize shrink width 10 px or 10 ppt
  bindsym Down resize grow height 10 px or 10 ppt
  bindsym Up resize shrink height 10 px or 10 ppt
  bindsym Right resize grow width 10 px or 10 ppt

  # back to normal: Enter or Escape
  bindsym Return mode "default"
  bindsym Escape mode "default"
}

# Audio shortcuts
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +3%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -3%

bindsym XF86AudioMute        exec amixer -D pulse sset Master toggle

#window switchy like ubuntu
bindsym Control+$mod+Right workspace next
bindsym Control+$mod+Left  workspace prev

# Sreen brightness controls
# bindsym XF86MonBrightnessUp   exec light -A 5 # increase screen brightness
# bindsym XF86MonBrightnessDown exec light -U 5 # decrease screen brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-


# media controls
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

#lock screen
# bindsym $mod+l exec "gnome-screensaver-command -l"
# bindcode $mod+$l exec "swaylock -i /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_2048x1536.png"
bindcode $mod+$l exec "swaylock -c 222222 -k"

# toggle keyboard layout
bindsym $sup+space exec ~/dotfiles/scripts/sway/layout.sh

# multiple bars to try making tray show only on inactive
bar {
    output          DP-3
    output          DisplayPort-2
    output          eDP-1
    swaybar_command waybar
    position        top
    font            pango:DejaVu Sans Mono 10
}

