output * bg ~/Pictures/wallpaper/wallhaven-cliff.jpg fill

input type:touchpad {
    tap enabled
    click_method clickfinger
    natural_scroll enabled
}

input type:keyboard {
  xkb_layout us
  xkb_variant dvorak

  xkb_options caps:escape

}

